# ════════════════════════════════════════════════════════════════════════
#  Sumuka Geleyara Balaga — Ganeshotsava 2026 Website
#  Environment Variables Template
#
#  HOW TO USE:
#  1. Copy this file:  cp .env.example .env.local
#  2. Fill in your real values below
#  3. NEVER commit .env.local to GitHub (it is in .gitignore)
#  4. On Render: add these as Environment Variables in the dashboard
#
#  REQUIRED on Render:
#    ADMIN_EMAIL, ADMIN_PASSWORD, MONGODB_URI
# ════════════════════════════════════════════════════════════════════════


# ── ADMIN LOGIN CREDENTIALS (Required) ───────────────────────────────
# Server-side only — never exposed to the browser.
# Set strong, unique values.
#
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-strong-password-here


# ── MONGODB ATLAS CONNECTION STRING (Required for persistent data) ───
# Without this, all admin changes revert on Render restart (ephemeral FS).
#
# HOW TO GET:
#  1. Create a free account at https://cloud.mongodb.com
#  2. Create a FREE cluster (M0 — always free, no credit card needed)
#  3. Go to: Database → Connect → Drivers → Node.js
#  4. Copy the connection string, replace <password> with your DB user password
#
# Example format:
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
#
MONGODB_URI=


# ── GOOGLE MAPS (Optional — for styled map embed) ─────────────────────
# Without this key, the location section still works with a plain embed.
# Get key: https://console.cloud.google.com → Maps JavaScript API
#
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
