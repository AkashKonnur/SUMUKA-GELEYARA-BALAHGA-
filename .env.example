# ════════════════════════════════════════════════════════════════════════
#  Sumuka Geleyara Balaga — Ganeshotsava 2026 Website
#  Environment Variables Template
#
#  HOW TO USE:
#  1. Copy this file:  cp .env.example .env.local
#  2. Fill in your real values below
#  3. NEVER commit .env.local to GitHub (it is in .gitignore)
#  4. On Render: add these as Environment Variables in the dashboard
# ════════════════════════════════════════════════════════════════════════


# ── ADMIN LOGIN CREDENTIALS (Required for admin panel) ───────────────
# These are your admin username and password for the CMS dashboard.
# Set strong, unique values. These are NEVER exposed to the browser.
#
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-strong-password-here


# ── FIREBASE CONFIGURATION (Optional — for Firestore CMS features) ───
# Without Firebase, the site still works using fallback/static data.
# To enable live CMS: create a Firebase project → Project Settings → Web App
#
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx


# ── GOOGLE MAPS (Optional — for styled map embed) ─────────────────────
# Without this key, the location section still works with a plain embed.
# Get key: https://console.cloud.google.com → Maps JavaScript API
#
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key


# ── FIREBASE CLOUD MESSAGING (Optional — for push notifications) ──────
# Only needed if you want browser push notifications for announcements.
#
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key
